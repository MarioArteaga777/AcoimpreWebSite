{
  "name": "acoimpre-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:html": "node build.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o css/tailwind.css --minify",
    "build": "npm run build:css && npm run build:html",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
